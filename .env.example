# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-postgres-password
POSTGRES_DB=postgres

# ── LiteLLM ──
LITELLM_MASTER_KEY=sk-litellm-master-changeme
LITELLM_DATABASE_URL=postgresql://litellm:changeme-postgres-password@postgres:5432/litellm

# ── 本地 Gemma 4 推論 ──
LOCAL_LLM_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_LLM_MODEL=gemma-4-26b-a4b-it-4bit

# ── Azure OpenAI ──
AZURE_API_KEY=changeme
AZURE_API_BASE=https://your-endpoint.openai.azure.com/
AZURE_API_VERSION=2024-10-21

# ── Anthropic ──
ANTHROPIC_API_KEY=sk-ant-changeme

# ── Langfuse ──
LANGFUSE_SECRET_KEY=sk-lf-changeme
LANGFUSE_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_HOST=http://langfuse:3100
LANGFUSE_DATABASE_URL=postgresql://langfuse:changeme-postgres-password@postgres:5432/langfuse
LANGFUSE_NEXTAUTH_SECRET=changeme-nextauth-secret
LANGFUSE_SALT=changeme-salt-value
LANGFUSE_CLICKHOUSE_URL=http://clickhouse:8123
LANGFUSE_S3_ENDPOINT=http://minio:9000
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_ACCESS_KEY=langfuse-access-key
LANGFUSE_S3_SECRET_KEY=langfuse-secret-key
LANGFUSE_S3_REGION=us-east-1

# ── Qdrant ──
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── MLflow ──
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:changeme-postgres-password@postgres:5432/mlflow

# ── Dagster ──
DAGSTER_PG_HOST=postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=changeme-postgres-password
DAGSTER_PG_DB=dagster

# ── MinIO ──
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=changeme-minio-password

# ── Mem0 ──
MEM0_S3_BUCKET=mem0
MEM0_S3_ACCESS_KEY=mem0-access-key
MEM0_S3_SECRET_KEY=mem0-secret-key

# ── Grafana ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme-grafana-password

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── NeMo Guardrails ──
GUARDRAILS_LLM_BASE_URL=http://litellm:4000/v1
GUARDRAILS_LLM_API_KEY=${LITELLM_MASTER_KEY}
